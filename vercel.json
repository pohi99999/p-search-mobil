{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/adatvedelem", "destination": "https://www.pohankaestarsa.com/p-search/adatvedelem", "permanent": true },
    { "source": "/adatvedelem.html", "destination": "https://www.pohankaestarsa.com/p-search/adatvedelem", "permanent": true },
    { "source": "/privacy", "destination": "https://www.pohankaestarsa.com/en/p-search/privacy", "permanent": true },
    { "source": "/privacy.html", "destination": "https://www.pohankaestarsa.com/en/p-search/privacy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
